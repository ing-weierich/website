---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageSections from '../components/PageSections.astro';
import { getPage } from '../lib/content';

const page = getPage('startseite');

if (!page) {
    throw new Error('Missing data/pages/startseite.json');
}
---

<BaseLayout title={page.meta?.title || page.slug} description={page.meta?.description}>
    <PageSections sections={page.sections} />
</BaseLayout>
