---
import { currentYear, navFooter, toURL, withBase } from '../lib/content';
---

<footer>
    <div class="footer-top">
        <img class="footer-fish" src={withBase('/fish.svg')} alt="" />
        <div class="footer-top-inner">
            <div class="footer-box">
                <div class="footer-headline">
                    Fundiertes Fachwissen und ein H&ouml;chstma&szlig; an <strong>professioneller Bearbeitung</strong>
                </div>
                <a class="footer-link" href="tel:015115381245">
                    <img class="footer-icon" src={withBase('/phone_white.svg')} alt="Handy" />
                    <span class="footer-data">0151 / 15 38 12 45</span>
                </a>
                <a class="footer-link" href="mailto:info@Ing-Weierich.de">
                    <img class="footer-icon" src={withBase('/mail_white.svg')} alt="E-Mail" />
                    <span class="footer-data">info@Ing-Weierich.de</span>
                </a>
            </div>
            <div class="footer-box">
                <div class="footer-text">Sie suchen nach einem kompetenten Partner in den Bereichen Gew&auml;sser&ouml;kologie und Gew&auml;sserplanung?</div>
                <div class="footer-text"><strong>Wir helfen Ihnen gerne unverbindlich weiter.</strong></div>
            </div>
        </div>
    </div>

    <div class="footer-bottom">
        <div class="footer-copy">&copy;Ingenieurb&uuml;ro Weierich {currentYear}</div>
        <nav class="footer-nav">
            {navFooter.map((item) => <a class="footer-nav-item" href={toURL(item.slug)}>{item.title}</a>)}
            <button class="footer-nav-item" type="button" data-cookie-open>Cookie-Einstellungen</button>
        </nav>
    </div>
</footer>
