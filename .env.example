# Google-Analytics-Measurement-ID (Format G-XXXXXXXXXX).
# Ohne Wert bleibt das Tracking komplett aus: die Kategorie "Statistik" wird
# nicht registriert, es erscheint kein Cookie-Banner und gtag.js wird nicht geladen.
#
# Der Produktivwert steht eingecheckt in .env.production (die ID ist kein
# Geheimnis, sie steht im ausgelieferten HTML). Diese Datei hier dient nur als
# Vorlage für lokale Overrides in einer .env.local.
PUBLIC_GA_MEASUREMENT_ID=
