# Google-Analytics-Measurement-ID der Property des Ingenieurbüros.
# Bewusst eingecheckt: die ID ist kein Geheimnis, sie steht im ausgelieferten
# HTML jeder Seite. Sie wird nur bei "astro build" gelesen, nicht bei "astro dev" —
# lokale Entwicklung sendet also nichts an Google.
PUBLIC_GA_MEASUREMENT_ID=G-G1TS5XTK3R
